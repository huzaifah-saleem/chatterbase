# MCP Server
MCP_SERVER_URL=http://127.0.0.1:8001
MCP_ENDPOINT=/mcp

# LLM Provider: "local_llm", "gemini", "openai", "nvidia_nim", or "lm_studio"
LLM_PROVIDER=lm_studio

# Local LLM Configuration (used by Local LLM, NVIDIA NIM, and LM Studio providers)
# For Local LLM (Ollama): Use native API endpoint (e.g., http://127.0.0.1:11434)
# For NVIDIA NIM: Use OpenAI-compatible endpoint (e.g., http://127.0.0.1:8000/v1)
# For LM Studio: Use OpenAI-compatible endpoint (e.g., http://127.0.0.1:1234/v1)
# NOTE: if running this app in Docker, replace 127.0.0.1 with host.docker.internal
# so the container can reach the LLM server running on your host machine.
LOCAL_LLM_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=your-model-name

# Google Gemini Configuration
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=model_name

# OpenAI Configuration
OPENAI_API_KEY=your_api_key
OPENAI_MODEL=model_name
